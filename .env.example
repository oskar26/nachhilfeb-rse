VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# NVIDIA API (server-side only – NICHT mit VITE_ prefixen!)
NVIDIA_API_KEY=nvapi-...
NVIDIA_LISTING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PARENT_BRIEFING_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ALL-INKL PHP-Backend (NICHT in Git committen – siehe api/db_credentials.php auf dem Server)
# DB_HOST=localhost
# DB_NAME=
# DB_USER=
# DB_PASS=
# JWT_SECRET=mindestens-32-Zeichen-zufaellig (Pflicht, kein Default im Repo!)
